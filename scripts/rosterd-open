#!/usr/bin/env bash
# rosterd-open, R9: resolves a runtime handle and jumps to the session. The handle is the roster
# record's (snake_case, camelCase accepted), on stdin or as --handle:
#
#   {"kind": "tmux|herdr|headless|none", "machine": "gibson",
#    "tmux": {"session": "agents", "window_index": 2, "pane_id": "%7"},
#    "herdr": {"session": "default", "workspace_id": "w3", "pane_id": "w3:p2", "agent_name": "builder"},
#    "session_key": "abc:42:7"}
#
#   rosterd-open --handle '<json>'         jump
#   rosterd-open --dry-run < handle.json   print what it would run, one command per line
#   rosterd-open --self-test
#
# tmux: switch-client/select-window/select-pane from inside tmux, tmux attach in a terminal outside
# it, over ssh when the machine is not this one. herdr: the herdr:// link when a handler is
# registered (examples/herdr-url-handler), else `herdr [--remote <machine>] --session <s> agent
# attach <name>` in a terminal. headless: the conversation view /ui/sessions/{key} in the browser.
#
# ROSTERD_MACHINE names this machine (default: hostname -s). ROSTERD_TERMINAL_CMD runs a command
# in a terminal window (the command is its last argument); default Terminal.app or x-terminal-emulator.
set -u

dry=0 handle=''
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --handle) handle=$2; shift 2 ;;
    --self-test) self_test=1; shift ;;
    -h | --help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "rosterd-open: unknown option $1" >&2; exit 2 ;;
  esac
done

if [ "${self_test-0}" = 1 ]; then
  fails=0
  check() { # $1 name, $2 env, $3 handle, $4 expected substring
    local out
    out=$(env $2 "$0" --dry-run --handle "$3" 2>&1)
    case "$out" in *"$4"*) ;; *) echo "FAIL $1: missing [$4] in: $out"; fails=$((fails + 1)) ;; esac
  }
  tmux='{"kind":"tmux","machine":"gibson","tmux":{"session":"agents","window_index":2,"window_name":"builder","pane_id":"%7"}}'
  check "tmux inside tmux, local" "ROSTERD_MACHINE=gibson TMUX=/tmp/x" "$tmux" \
    'tmux switch-client -t agents
tmux select-window -t agents:2
tmux select-pane -t %7'
  check "tmux outside tmux, local" "ROSTERD_MACHINE=gibson TMUX=" "$tmux" 'terminal tmux attach -t agents \; select-window -t agents:2 \; select-pane -t %7'
  # Through ssh the remote shell strips one level, so tmux's ; separators travel as \\;.
  check "tmux remote" "ROSTERD_MACHINE=wintermute TMUX=" "$tmux" 'terminal ssh gibson -t tmux attach -t agents \\; select-window -t agents:2 \\; select-pane -t %7'
  check "tmux camelCase" "ROSTERD_MACHINE=gibson TMUX=/tmp/x" '{"kind":"tmux","machine":"gibson","tmux":{"session":"a","windowIndex":1,"paneId":"%3"}}' 'tmux select-pane -t %3'
  herdr='{"kind":"herdr","machine":"gibson","herdr":{"session":"default","workspace_id":"w3","pane_id":"w3:p2","agent_name":"builder"}}'
  check "herdr local" "ROSTERD_MACHINE=gibson ROSTERD_HERDR_LINK=0" "$herdr" 'herdr --session default agent focus w3:p2'
  check "herdr remote" "ROSTERD_MACHINE=wintermute ROSTERD_HERDR_LINK=0" "$herdr" 'terminal herdr --remote gibson --session default'
  check "herdr link" "ROSTERD_MACHINE=wintermute ROSTERD_HERDR_LINK=1" "$herdr" 'browser herdr://gibson/agents/attach/builder?session=default'
  check "herdr pane only" "ROSTERD_MACHINE=gibson ROSTERD_HERDR_LINK=0" '{"kind":"herdr","machine":"gibson","herdr":{"session":"s","workspace_id":"w","pane_id":"w:p9"}}' \
    'herdr --session s agent focus w:p9'
  check "headless" "ROSTERD_LOOPBACK_PORT=8790 ROSTERD_CONFIG_DIR=/nonexistent" '{"kind":"headless","machine":"gibson","session_key":"abc:42:7"}' \
    'browser http://127.0.0.1:8790/ui/sessions/abc:42:7'
  check "none" "" '{"kind":"none","machine":"gibson"}' 'nothing to open'
  check "unsafe" "ROSTERD_MACHINE=gibson TMUX=" '{"kind":"tmux","machine":"gibson; rm -rf /","tmux":{"session":"a","window_index":0,"pane_id":"%1"}}' 'unusable machine'
  [ "$fails" = 0 ] && echo "rosterd-open self-test: ok" || { echo "rosterd-open self-test: $fails failed"; exit 1; }
  exit 0
fi

command -v jq >/dev/null 2>&1 || { echo "rosterd-open: jq is needed to read the handle" >&2; exit 2; }
[ -n "$handle" ] || handle=$(cat)
field() { printf '%s' "$handle" | jq -r "$1 // empty" 2>/dev/null; }

# Everything that reaches a shell is one word of a plain alphabet, as herdr-open does: the handle
# came from a page or a peer.
safe() {
  case "$1" in
    '' | *[!A-Za-z0-9._@:%/-]*) echo "rosterd-open: unusable $2 in the handle: $1" >&2; exit 2 ;;
  esac
  printf '%s' "$1"
}

run() { if [ "$dry" = 1 ]; then echo "$*"; else "$@"; fi; }
browser() {
  if [ "$dry" = 1 ]; then echo "browser $1"; return; fi
  case "$(uname)" in Darwin) open "$1" ;; *) xdg-open "$1" ;; esac
}
# One shell command in a terminal window the human can see.
terminal() {
  if [ "$dry" = 1 ]; then echo "terminal $*"; return; fi
  if [ -n "${ROSTERD_TERMINAL_CMD-}" ]; then exec $ROSTERD_TERMINAL_CMD "$*"; fi
  case "$(uname)" in
    Darwin)
      script=${*//\\/\\\\}; script=${script//\"/\\\"} # an AppleScript string literal
      osascript -e "tell application \"Terminal\" to do script \"$script\"" -e 'tell application "Terminal" to activate' >/dev/null
      ;;
    *) exec "$(command -v x-terminal-emulator || command -v xterm)" -e sh -lc "$*" ;;
  esac
}
# Whether a herdr:// handler is registered, R9; ROSTERD_HERDR_LINK=0|1 overrides.
herdr_link_registered() {
  case "${ROSTERD_HERDR_LINK-}" in 1) return 0 ;; 0) return 1 ;; esac
  case "$(uname)" in
    Darwin) [ -d "$HOME/Applications/Herdr Link.app" ] ;;
    *) [ -n "$(xdg-mime query default x-scheme-handler/herdr 2>/dev/null)" ] ;;
  esac
}

here=${ROSTERD_MACHINE:-$(hostname -s 2>/dev/null || hostname)}
machine=$(field .machine)
[ -n "$machine" ] || machine=$here
machine=$(safe "$machine" machine) || exit 2
local=0; [ "$machine" = "$here" ] && local=1

case "$(field .kind)" in
  tmux)
    session=$(safe "$(field '.tmux.session')" 'tmux session') || exit 2
    window=$(safe "$(field '.tmux.window_index // .tmux.windowIndex')" 'tmux window') || exit 2
    pane=$(safe "$(field '.tmux.pane_id // .tmux.paneId')" 'tmux pane') || exit 2
    if [ "$local" = 1 ] && [ -n "${TMUX-}" ]; then
      run tmux switch-client -t "$session" && run tmux select-window -t "$session:$window" && run tmux select-pane -t "$pane"
    elif [ "$local" = 1 ]; then
      terminal "tmux attach -t $session \\; select-window -t $session:$window \\; select-pane -t $pane"
    else
      terminal "ssh $machine -t tmux attach -t $session \\\\; select-window -t $session:$window \\\\; select-pane -t $pane"
    fi
    ;;
  herdr)
    session=$(safe "$(field '.herdr.session')" 'herdr session') || exit 2
    agent=$(field '.herdr.agent_name // .herdr.agentName')
    pane=$(safe "$(field '.herdr.pane_id // .herdr.paneId')" 'herdr pane') || exit 2
    if [ -n "$agent" ]; then
      agent=$(safe "$agent" 'agent name') || exit 2
      link="herdr://$machine/agents/attach/$agent?session=$session"
    else
      link="herdr://$machine/panes/observe/$pane?session=$session"
    fi
    # Local: focus the pane inside the running Herdr, no new terminal. Remote: a terminal on the
    # remote session, since `herdr --remote` takes no subcommand.
    if [ "$local" = 1 ]; then
      if [ "$dry" = 1 ]; then echo "herdr --session $session agent focus $pane"; else
        herdr --session "$session" agent focus "$pane" >/dev/null 2>&1 || herdr --session "$session" workspace focus "${pane%%:*}" >/dev/null
      fi
    elif herdr_link_registered; then
      browser "$link"
    else
      terminal "herdr --remote $machine --session $session"
    fi
    ;;
  headless)
    key=$(safe "$(field .session_key)" 'session key') || exit 2
    port=${ROSTERD_LOOPBACK_PORT-}
    config_dir=${ROSTERD_CONFIG_DIR-}
    if [ -z "$config_dir" ]; then
      case "$(uname)" in Darwin) config_dir="$HOME/Library/Application Support/rosterd" ;; *) config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rosterd" ;; esac
    fi
    [ -n "$port" ] || port=$(sed -n 's/^[[:space:]]*loopback_port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$config_dir/rosterd.toml" 2>/dev/null | head -n1)
    [ -n "$port" ] || port=8790
    # The page keeps the bearer from ?token= in sessionStorage, so the first open signs in.
    token=$(cat "$config_dir/loopback.token" 2>/dev/null || true)
    # ponytail: a headless session on another node is opened through this node's loopback; the
    # api proxies /sessions under /swarm/{node_id}/, the page follows the key's node id.
    browser "http://127.0.0.1:$port/ui/sessions/$key${token:+?token=$token}"
    ;;
  *)
    echo "rosterd-open: nothing to open for kind '$(field .kind)' on $machine" >&2
    exit 1
    ;;
esac
