#!/usr/bin/env bash
# rosterd-launch, R4 and R5.1: starts a harness in the interactive lane with the rosterd MCP
# server in its environment, registered with the local daemon as source launcher before the
# harness runs.
#
#   rosterd-launch [--name <n>] [--harness claude|codex] [--tmux] [--socket <path>] [--dry-run] -- <harness command...>
#
#   rosterd-launch --name writer -- claude --model opus
#   rosterd-launch --harness codex -- codex
#   rosterd-launch --tmux --name writer -- claude      in a new tmux session, attachable from any node
#
# Exports ROSTERD_SOCKET and ROSTERD_HARNESS, registers {source: launcher, pid: $$, ...} with
# the daemon, then execs the harness: same pid, so the registration names the process the
# scanner will find, and signals and the tty stay the harness's own. tmux handles are the
# scanner's, not the launcher's: --tmux outside tmux re-runs this script in a new tmux session
# named after --name (else the harness), so the pane the scanner finds is the session's from
# birth. Without a daemon it still starts the harness (fail open, R4).
set -u

argv=("$@")
name='' harness='' socket="${ROSTERD_SOCKET-}" dry=0 in_tmux=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name=$2; shift 2 ;;
    --harness) harness=$2; shift 2 ;;
    --tmux) in_tmux=1; shift ;;
    --socket) socket=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --self-test) self_test=1; shift ;;
    --) shift; break ;;
    -h | --help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "rosterd-launch: unknown option $1" >&2; exit 2 ;;
  esac
done
if [ "${self_test-0}" = 1 ]; then
  out=$("$0" --dry-run --name writer --socket /tmp/rosterd-test.sock -- claude --model opus)
  fails=0
  for want in 'export ROSTERD_SOCKET=/tmp/rosterd-test.sock' 'export ROSTERD_HARNESS=claude' \
    'register {"source":"launcher","pid":' '"harness":"claude","lane":"interactive","name":"writer","cwd":"' \
    'exec claude --model opus'; do
    case "$out" in *"$want"*) ;; *) echo "FAIL: missing [$want] in: $out"; fails=$((fails + 1)) ;; esac
  done
  out=$("$0" --dry-run --harness codex --socket /tmp/rosterd-test.sock --)
  case "$out" in *'exec codex'*) ;; *) echo "FAIL: bare --harness codex should exec codex: $out"; fails=$((fails + 1)) ;; esac
  out=$(TMUX= "$0" --dry-run --tmux --name writer --socket /tmp/rosterd-test.sock -- claude)
  case "$out" in *"exec tmux new-session -s writer -c $PWD -- $0 --socket /tmp/rosterd-test.sock --dry-run --tmux --name writer --socket /tmp/rosterd-test.sock -- claude"*) ;; *) echo "FAIL: --tmux should re-run in tmux: $out"; fails=$((fails + 1)) ;; esac
  out=$(TMUX=/tmp/x "$0" --dry-run --tmux --name writer -- claude)
  case "$out" in *'exec claude'*) ;; *) echo "FAIL: --tmux inside tmux should exec the harness: $out"; fails=$((fails + 1)) ;; esac
  [ "$fails" = 0 ] && echo "rosterd-launch self-test: ok" || { echo "rosterd-launch self-test: $fails failed"; exit 1; }
  exit 0
fi
cmd=("$@")
[ ${#cmd[@]} -gt 0 ] || cmd=("${harness:-claude}")
[ -n "$harness" ] || harness=$(basename "${cmd[0]}")

# The daemon socket, R6, as rosterd-hook resolves it: the override, the runtime dir, the shell's
# TMPDIR, the Darwin per-user temp dir (a daemon launchd started has no TMPDIR), /tmp, then
# /run/rosterd for the system unit. First one that exists wins.
if [ -z "$socket" ]; then
  tmp=${TMPDIR:-/tmp}
  darwin=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)
  for c in "${XDG_RUNTIME_DIR-}/rosterd.sock" "/run/user/$(id -u)/rosterd.sock" "${tmp%/}/rosterd.sock" "${darwin:+${darwin%/}/rosterd.sock}" /tmp/rosterd.sock /run/rosterd/rosterd.sock; do
    case "$c" in /*) [ -S "$c" ] && { socket=$c; break; } ;; esac
  done
  [ -n "$socket" ] || socket=${tmp%/}/rosterd.sock
fi

# Outside tmux with --tmux: the same command again inside a new session, this pid becoming the
# harness's there. The socket goes along by argument, the tmux server's environment is not this
# shell's. The name is unique per server, tmux refuses a duplicate.
if [ "$in_tmux" = 1 ] && [ -z "${TMUX-}" ]; then
  sess=${name:-$harness}; sess=${sess//[^A-Za-z0-9_-]/_}
  [ "$dry" = 1 ] || while tmux has-session -t "=$sess" 2>/dev/null; do sess="$sess-$RANDOM"; done
  [ "$dry" = 1 ] && { echo "exec tmux new-session -s $sess -c $PWD -- $0 --socket $socket ${argv[*]}"; exit 0; }
  exec tmux new-session -s "$sess" -c "$PWD" -- "$0" --socket "$socket" "${argv[@]}"
fi

# The config directory as crates/rosterd/src/config.rs resolves it (dirs::config_dir).
config_dir=${ROSTERD_CONFIG_DIR-}
if [ -z "$config_dir" ]; then
  case "$(uname)" in
    Darwin) config_dir="$HOME/Library/Application Support/rosterd" ;;
    *) config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rosterd" ;;
  esac
fi

jstr() { # a JSON string literal, or null when empty
  [ -n "$1" ] || { printf 'null'; return; }
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}
daemon() { # $1 method, $2 path, $3 body; empty output when the daemon is not there
  [ "$dry" = 1 ] && [ "$1" = GET ] && return 0
  [ -S "$socket" ] || return 0
  curl -sS --max-time 2 --unix-socket "$socket" -X "$1" -H 'Content-Type: application/json' ${3:+--data "$3"} "http://rosterd$2" 2>/dev/null || true
}
jq_or() { # $1 json, $2 jq filter, $3 default
  local v=''
  command -v jq >/dev/null 2>&1 && [ -n "$1" ] && v=$(printf '%s' "$1" | jq -r "$2 // empty" 2>/dev/null)
  printf '%s' "${v:-$3}"
}

status=$(daemon GET /status)
port=$(jq_or "$status" '.loopback_port // .node.loopback_port // .loopback.port' '')
[ -n "$port" ] || port=$(sed -n 's/^[[:space:]]*loopback_port[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$config_dir/rosterd.toml" 2>/dev/null | head -n1)
[ -n "$port" ] || port=8790

export ROSTERD_SOCKET="$socket" ROSTERD_HARNESS="$harness"

# Register first with this shell's pid: exec below keeps pid and start time, so the record is the
# harness's. The answer carries the session key the MCP server identifies the caller by.
body="{\"source\":\"launcher\",\"pid\":$$,\"harness\":$(jstr "$harness"),\"lane\":\"interactive\",\"name\":$(jstr "$name"),\"cwd\":$(jstr "$PWD")}"
if [ "$dry" = 1 ]; then
  for v in ROSTERD_SOCKET ROSTERD_HARNESS; do
    eval "[ -n \"\${$v-}\" ] && echo \"export $v=\$$v\""
  done
  echo "register $body"
  echo "exec ${cmd[*]}"
  exit 0
fi
record=$(daemon POST /register "$body")
session_key=$(jq_or "$record" '.session_key // .record.session_key' '')

# The rosterd MCP server, R6, over loopback with the bearer of <config dir>/loopback.token.
# ponytail: the temp file is left behind (exec has no after); it is 0600 and the tmpdir reaper's.
loopback_token=$(cat "$config_dir/loopback.token" 2>/dev/null || true)
if [ -n "$loopback_token" ]; then
  mcp_url="http://127.0.0.1:$port/mcp"
  case "$harness" in
    claude)
      mcp_file="${TMPDIR:-/tmp}/rosterd-mcp-$$.json"
      headers="\"Authorization\":\"Bearer $loopback_token\"${session_key:+,\"X-Rosterd-Session\":\"$session_key\"}"
      (umask 077; printf '{"mcpServers":{"rosterd":{"type":"http","url":"%s","headers":{%s}}}}\n' "$mcp_url" "$headers" >"$mcp_file")
      cmd+=(--mcp-config "$mcp_file")
      ;;
    codex)
      export ROSTERD_LOOPBACK_TOKEN="$loopback_token"
      cmd+=(-c "mcp_servers.rosterd.url=\"$mcp_url\"" -c 'mcp_servers.rosterd.bearer_token_env_var="ROSTERD_LOOPBACK_TOKEN"')
      [ -n "$session_key" ] && cmd+=(-c "mcp_servers.rosterd.http_headers={\"X-Rosterd-Session\"=\"$session_key\"}")
      ;;
  esac
fi

exec "${cmd[@]}"
