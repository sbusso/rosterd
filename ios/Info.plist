<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Scans the pairing code on the roster page.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>rosterd</string>
			<key>CFBundleURLSchemes</key>
			<array><string>rosterd</string></array>
		</dict>
	</array>
	<!-- The daemon speaks plain HTTP on the tailnet; WireGuard is the transport security, R7.6. -->
